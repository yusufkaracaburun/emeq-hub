                              "name": "Heading",
                              "fill": "$foreground",
                              "content": "Doeleinden en grondslag",
                              "fontFamily": "$font-body",
                              "fontSize": "$text-lg",
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "fNuvV",
                              "name": "Body",
                              "fill": "$muted-foreground",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "•  Uitvoeren van de koppeling die de Consumer en zijn eindgebruiker hebben aangevraagd — grondslag: uitvoering van de overeenkomst.\n•  Beveiliging, fraudepreventie en incident-triage — grondslag: gerechtvaardigd belang bij een veilig en betrouwbaar platform.\n•  Voldoen aan wettelijke verplichtingen waar die van toepassing zijn.\nWij gebruiken de gegevens niet voor profilering, advertenties of doorverkoop.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": "$text-md",
                              "fontWeight": "normal"
                            }
                          ]
                        }
