### ─── Ontvangsten en uitgaven ────────────────────────────────────────────────
#
# `income` en `expense` zijn géén memoriaal: ze dragen een relatie en een
# categorie en boeken daarom als gewone verkoop- respectievelijk inkoopboeking,
# met een openstaande post die later via de bankreconciliatie wordt afgeletterd.

### Ontvangst — debiteur, verkoopdagboek
POST {{baseUrl}}/v1/accounting/documents
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
X-Account-Id: {{accountId}}
Idempotency-Key: {{$guid}}

{
  "type": "income",
  "external_id": "INC-001",
  "number": "Ontvangst 001",
  "issue_date": "2026-08-14",
  "party": { "role": "debtor", "kind": "company", "name": "Hub Test Klant", "external_id": "KLANT-001", "chamber_of_commerce": "12345678" },
  "lines": [
    { "description": "Doorbelasting materiaal", "amount": 150, "tax_rate": 21, "category": "omzet" }
  ]
}

### Uitgave — crediteur, inkoopdagboek
POST {{baseUrl}}/v1/accounting/documents
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
X-Account-Id: {{accountId}}
Idempotency-Key: {{$guid}}

{
  "type": "expense",
  "external_id": "EXP-001",
  "number": "Uitgave 001",
  "issue_date": "2026-08-14",
  "party": { "role": "creditor", "kind": "company", "name": "Hub Test Leverancier", "external_id": "LEV-001", "chamber_of_commerce": "87651234" },
  "lines": [
    { "description": "Gereedschap", "amount": 80, "tax_rate": 21, "category": "kosten" }
  ]
}


### ─── Onbekende relatie ──────────────────────────────────────────────────────

### Zakelijke partij ZONDER KvK én ZONDER btw-nummer → 422 op de edge.
#   De Hub zou zo'n relatie alleen op naam kunnen herkennen, en een naam-miss zet
#   een duplicaat in de administratie van de klant. Vul het aan in de bron.
POST {{baseUrl}}/v1/accounting/documents
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
X-Account-Id: {{accountId}}
Idempotency-Key: {{$guid}}

{
  "type": "sales_invoice",
  "external_id": "NEW-001",
  "number": "Zakelijke klant zonder sleutel",
  "issue_date": "2026-08-14",
  "party": { "role": "debtor", "kind": "company", "name": "Gloednieuwe Klant BV", "external_id": "KLANT-NIEUW-001" },
  "lines": [
    { "description": "Consultancy", "amount": 100, "tax_rate": 21 }
  ]
}

### Nieuwe relatie mét volledige relatiekaart.
#   De kaartvelden tellen alleen bij het aanmaken; een bestaande relatie raakt de
#   Hub niet aan. Wat je niet zeker weet, laat je weg.
POST {{baseUrl}}/v1/accounting/documents
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
X-Account-Id: {{accountId}}
Idempotency-Key: {{$guid}}

{
  "type": "sales_invoice",
  "external_id": "NEW-003",
  "number": "Nieuwe klant met kaart",
  "issue_date": "2026-08-14",
  "party": {
    "role": "debtor",
    "kind": "company",
    "name": "Volledige Klant BV",
    "external_id": "KLANT-NIEUW-003",
    "vat_number": "NL000099998B57",
    "chamber_of_commerce": "12345678",
    "address_line_1": "Dorpsstraat 1",
    "postcode": "1234 AB",
    "city": "Amsterdam",
    "country": "NL",
    "email": "facturen@volledigeklant.nl",
    "phone": "+31201234567",
    "website": "https://volledigeklant.nl"
  },
  "lines": [
    { "description": "Consultancy", "amount": 100, "tax_rate": 21 }
  ]
}

### Zelfde partij MET KvK → 201 + één nieuwe relatie in Exact.
#   De ladder zoekt eerst op de mirror, dan KvK, dan btw, dan genormaliseerde naam,
#   en maakt de relatie pas aan als alle vier missen. `warnings[]` in het antwoord
#   draagt `relation.created`.
POST {{baseUrl}}/v1/accounting/documents
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
X-Account-Id: {{accountId}}
Idempotency-Key: {{$guid}}

{
  "type": "sales_invoice",
  "external_id": "NEW-002",
  "number": "Nieuwe klant met KvK",
  "issue_date": "2026-08-14",
  "party": {
    "role": "debtor",
    "kind": "company",
    "name": "Gloednieuwe Klant BV",
    "external_id": "KLANT-NIEUW-001",
    "chamber_of_commerce": "87654321"
  },
  "lines": [
    { "description": "Consultancy", "amount": 100, "tax_rate": 21 }
  ]
}

### Particulier → geen sterke sleutel nodig, wordt aangemaakt na een mirror-miss.
#   De ladder slaat KvK, btw en de naam-probe over: twee gelijknamige personen
#   zouden anders aan elkaars factuur gekoppeld worden.
POST {{baseUrl}}/v1/accounting/documents
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
X-Account-Id: {{accountId}}
Idempotency-Key: {{$guid}}

{
  "type": "sales_invoice",
  "external_id": "NEW-004",
  "number": "Particuliere klant",
  "issue_date": "2026-08-14",
  "party": {
    "role": "debtor",
    "kind": "person",
    "name": "Jan Jansen",
    "external_id": "KLANT-NIEUW-004"
  },
  "lines": [
    { "description": "Consultancy", "amount": 100, "tax_rate": 21 }
  ]
}


