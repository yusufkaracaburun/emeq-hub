# Lokale secrets voor handmatige .http-requests in deze map.
# Kopieer: cp .env.example .env
#
# ── Fase 1: partner/domain-overview.http (direct naar DataForSEO) ─────────────────
#
# Login + wachtwoord uit https://app.dataforseo.com/api-access
# DATAFORSEO_BASIC = base64("login:password") voor de Authorization-header.

DATAFORSEO_API_URL=https://api.dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASIC=

# Testdata (partner/*.http) — geen aanhalingstekens om de waarde heen
DOMAIN=planny.nl
LOCATION_NAME=Netherlands
LOCATION_CODE=2528
LANGUAGE_CODE=nl

# LOCATION_NAME → domain-overview.http (domain_rank_overview)
# LOCATION_CODE + LANGUAGE_CODE → keywords.http, serp.http
#
# 2528 = Netherlands (NL). Was hier eerder 2826 — dat is het United Kingdom-
# location_code, geen Nederland. Codes staan bij DataForSEO zelf, niet gokken:
# https://docs.dataforseo.com/v3/dataforseo_labs/locations_and_languages/
#
# domain_rank_overview met location_code=2826 (UK) + language_code=nl gaf
# 40501 "Invalid field" (live getest) — vermoedelijk de ongeldige combinatie
# UK-locatie + Nederlandse taal, niet het language_code-veld zelf (dat staat
# los als optioneel veld in de officiële docs). Hub-kant stuurt daarom alleen
# location_name mee, geen language_code — dat is een bewuste vereenvoudiging,
# geen bevestigde endpoint-restrictie.

# ── Fase 2: consumer/domain-overview.http (Hub /v1/dataforseo) ───────────────────────────
#
# PAT: /admin → Consumer → Issue PAT (ability dataforseo:read of *).
# Hub-code: branch agent/open-seo (tot merge).

EMEQ_HUB_PAT=1|
