# Lokale secrets voor handmatige .http-requests in deze map.
# Kopieer: cp .env.example .env
#
# ── Fase 1: partner/domain-overview.http (direct naar DataForSEO) ─────────────────
#
# Login + wachtwoord uit https://app.dataforseo.com/api-access
# DATAFORSEO_BASIC = base64("login:password") voor de Authorization-header.

DATAFORSEO_API_URL=https://api.dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASIC=

# Testdata (partner/*.http) — geen aanhalingstekens om de waarde heen
DOMAIN=planny.nl
LOCATION_NAME=Netherlands
LOCATION_CODE=2826
LANGUAGE_CODE=nl

# LOCATION_NAME → domain-overview.http (domain_rank_overview)
# LOCATION_CODE + LANGUAGE_CODE → keywords.http, serp.http
# domain_rank_overview weigert language_code "nl" (40501); stuur die daar niet mee

# ── Fase 2: consumer/domain-overview.http (Hub /v1/dataforseo) ───────────────────────────
#
# PAT: /admin → Consumer → Issue PAT (ability dataforseo:read of *).
# Hub-code: branch agent/open-seo (tot merge).

EMEQ_HUB_PAT=1|
