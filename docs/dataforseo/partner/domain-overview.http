# DataForSEO partner-API — domain rank overview (live)
#
# Setup: docs/dataforseo/.env (zie .env.example).
# Gebruik LOCATION_NAME (niet LOCATION_CODE=2826 — dat is UK, geen NL).
# language_code=nl + location_code=2826 gaf 40501 (live getest, vermoedelijk
# de UK+nl-combinatie); language_code is officieel optioneel op dit endpoint,
# maar we laten 'm hier bewust weg. Zie .env.example voor de bronverwijzing.
# Succes: tasks_error = 0, tasks[0].status_code = 20000, result gevuld.

@apiBase = {{$dotenv DATAFORSEO_API_URL}}
@basic = {{$dotenv DATAFORSEO_BASIC}}
@domain = {{$dotenv DOMAIN}}
@location_name = {{$dotenv LOCATION_NAME}}
###
POST {{apiBase}}/v3/dataforseo_labs/google/domain_rank_overview/live
Authorization: Basic {{basic}}
Content-Type: application/json
Accept: application/json

[
  {
    "target": "{{domain}}",
    "location_name": "{{location_name}}"
  }
]
