# DataForSEO partner-API — backlinks summary (live)
#
# Setup: docs/dataforseo/.env (zie .env.example).
# backlinks_status_type: "live" | "all" | "lost" (default hier: live).

@apiBase = {{$dotenv DATAFORSEO_API_URL}}
@basic = {{$dotenv DATAFORSEO_BASIC}}
@domain = {{$dotenv DOMAIN}}
###
POST {{apiBase}}/v3/backlinks/summary/live
Authorization: Basic {{basic}}
Content-Type: application/json
Accept: application/json

[
  {
    "target": "{{domain}}",
    "internal_list_limit": 10,
    "include_subdomains": true,
    "backlinks_status_type": "live"
  }
]
