# DataForSEO partner-API: SERP organic
#
# Setup: docs/dataforseo/.env (zie .env.example).
#
# Eerste request: live/advanced, synchroon. Dit endpoint gebruikt de Hub
# voor /v1/dataforseo/serp-organic. depth 1-200 (default 10), afgerekend
# per 10 resultaten.
#
# Daarna de async variant, goedkoper maar met wachttijd:
# Flow: 1) task_post → kopieer tasks[0].id naar @taskId
#       2) wacht ~5–60s
#       3) task_get → tasks[0].status_code 20000 = resultaat klaar
# task_post geeft task-status 20100 ("Task Created"), dat is normaal.

@apiBase = {{$dotenv DATAFORSEO_API_URL}}
@basic = {{$dotenv DATAFORSEO_BASIC}}
@location_code = {{$dotenv LOCATION_CODE}}
@language_code = {{$dotenv LANGUAGE_CODE}}
@keyword = boekhouding software
@taskId = VUL-HIER-DE-ID-UIT-STAP-1-IN
###
POST {{apiBase}}/v3/serp/google/organic/live/advanced
Authorization: Basic {{basic}}
Content-Type: application/json
Accept: application/json

[
  {
    "keyword": "{{keyword}}",
    "location_code": {{location_code}},
    "language_code": "{{language_code}}",
    "device": "desktop",
    "depth": 10
  }
]
###
POST {{apiBase}}/v3/serp/google/organic/task_post
Authorization: Basic {{basic}}
Content-Type: application/json
Accept: application/json

[
  {
    "keyword": "{{keyword}}",
    "location_code": {{location_code}},
    "language_code": "{{language_code}}",
    "device": "desktop"
  }
]
###
GET {{apiBase}}/v3/serp/google/organic/task_get/regular/{{taskId}}
Authorization: Basic {{basic}}
Accept: application/json
