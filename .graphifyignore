# Dependencies — matched at ANY depth, not just the root.
# emeq-hub has vendor/ at the root, a nested vendor/vendor/, and one per package
# under packages/*/vendor/. A root-only `vendor/` pattern would miss the last two
# and they would dominate the graph — that is exactly what happened in emeq,
# where a stray Laravel copy became 72% of all nodes and every query returned
# PHPUnit internals.
**/vendor/
vendor/
**/node_modules/
node_modules/
.pnpm-store/

# Laravel runtime + build artefacts
storage/framework/
storage/logs/
storage/app/public/
bootstrap/cache/
public/build/
public/hot/
public/storage/

