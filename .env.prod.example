# Prod-env — kopieer naar .env.prod op de server en vul de secrets.
# .env.prod is gitignored; committen = lek. Genereer APP_KEY met:
#   docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show

APP_NAME="Emeq Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hub.emeq.nl
OCTANE_SERVER=frankenphp

# Cloudflare Tunnel — CF termineert TLS aan de rand, cloudflared bouwt een
# uitgaande verbinding naar de app. Geen open poort, server-IP blijft verborgen,
# geen Let's Encrypt/SERVER_NAME nodig. Laravel vertrouwt de proxy via
# trustProxies (bootstrap/app.php). Token: Zero-Trust-dashboard → Networks →
# Tunnels → connector installeren (begint met "ey…"). Dit is een secret.
CLOUDFLARE_TUNNEL_TOKEN=

# Postgres — `db`-container (compose-netwerk), niet 127.0.0.1.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=emeq_hub
DB_USERNAME=emeq_hub
DB_PASSWORD=

# Redis — `redis`-container. predis (pure PHP), geen ext-redis.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
# Leeg = geen auth (alleen bereikbaar binnen het compose-netwerk, geen open poort).
# Zet een echt wachtwoord + wire `--requirepass` in docker-compose.prod.yml in één
# gecoördineerde deploy. NIET de string "null" gebruiken: compose zou dat letterlijk
# als wachtwoord zetten terwijl Laravel `null` als geen-auth leest → auth-mismatch.
REDIS_PASSWORD=

# Alles via Redis — gelijk aan dev.
SESSION_DRIVER=redis
# https via Cloudflare → secure cookies aan.
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Logs naar dagelijks-geroteerd bestand (14d) én stderr, zodat ze in de Docker-
# daemon-logrotatie (10m×3) vallen en via `make prod-logs` zichtbaar zijn. Zonder
# LOG_STACK valt `stack` terug op één onbegrensd storage/logs/laravel.log.
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# Sentry — foutrapportage in prod (config/sentry.php + Integration::handles staan
# al klaar). Zonder DSN blijft Sentry uit. Maak een prod-project aan en plak de DSN.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# CORS — elke https-origin mag de /v1-API aanroepen (multi-tenant consumers op
# losse domeinen: emeq.nl, planny.nl, …; geen per-consumer config). Auth is de
# PAT, niet CORS. CORS_ALLOWED_ORIGINS alleen voor expliciete niet-https/dev
# hosts; in prod normaal leeg laten.
CORS_ALLOWED_ORIGINS=
