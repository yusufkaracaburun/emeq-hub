APP_NAME="Emeq Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://hub.emeq.test:8090

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,nightwatch
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=emeq_hub
DB_USERNAME=emeq_hub
DB_PASSWORD=emeq_hub

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hub@emeq.nl"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=hub.emeq.test

HORIZON_PREFIX=emeq-hub

# Backups (spatie/laravel-backup). Zonder wachtwoord = onversleutelde dumps;
# zet in productie een sterk wachtwoord (`openssl rand -hex 32`) zodat de
# AES-256-encryptie aan gaat. Off-site loopt via de OVH Automated Backup-snapshot.
BACKUP_ARCHIVE_PASSWORD=

API_VERSION=0.2.0-dev

# Snelstart
SNELSTART_PARTNER_APP_NAME=
SNELSTART_PRIMARY_KEY=
SNELSTART_SECONDARY_KEY=

# Snelstart webhook (Phase 5c) — globale partner-secret + rotation-window.
# Header + algo zijn 🔒 confirmed (X-SnelStart-Signature + sha256, partner-respons 2026-05-17),
# defaults zijn config-driven mocht Snelstart later wisselen zonder code-deploy.
SNELSTART_WEBHOOK_SECRET=
SNELSTART_WEBHOOK_SECRET_NEXT=
SNELSTART_WEBHOOK_SIGNATURE_HEADER=X-SnelStart-Signature
SNELSTART_WEBHOOK_SIGNATURE_ALGO=sha256
SNELSTART_WEBHOOK_EVENT_ID_KEY=eventId

# Mollie
MOLLIE_PARTNER_CLIENT_ID=
MOLLIE_PARTNER_CLIENT_SECRET=

# Mollie partner-access-token voor /v1/mollie/connect/* routes (Phase 13, D-04). Long-lived, statisch — productie via de VPS `.env.prod`.
MOLLIE_PARTNER_ACCESS_TOKEN=

# Mollie Connect (OAuth-broker — Phase 4)
MOLLIE_CONNECT_CLIENT_ID=
MOLLIE_CONNECT_CLIENT_SECRET=
MOLLIE_CONNECT_REDIRECT_URI=https://hub.emeq.test:8090/v1/oauth/mollie/callback

# Mollie webhook signing — platform-secret van Mollie Connect (Phase 5a D-08)
MOLLIE_WEBHOOK_SECRET=

# Cashier-Mollie — Emeq's eigen Mollie test-account (use-case A, Phase 6)
# Dit is NIET een Connect-token (= Phase 4/5a/7) en NIET een Consumer-credential.
# Dit is de test-API-key uit Emeq's eigen Mollie-dashboard waar Naschool/Planny
# op factureren. Productiekey komt pas bij milestone-go-live, niet in v0.2.
# CASHIER_MOLLIE_KEY en MOLLIE_KEY moeten identiek zijn — laravel-mollie ^4.0
# leest `MOLLIE_KEY`, Cashier-Mollie's docs verwijzen naar `CASHIER_MOLLIE_KEY`.
CASHIER_MOLLIE_KEY=test_xxx
MOLLIE_KEY=test_xxx

# Webhook-secret voor Cashier-webhook hard-fail-guard (Phase 5a-pattern, plan 06-06).
# Genereer met `openssl rand -hex 32` en plak hier + in Mollie-dashboard's
# webhook-endpoint config. Leeg/null laat het Cashier-webhook hard-failen
# (500 + audit-row) — bewust, om open ingress te voorkomen.
CASHIER_WEBHOOK_SECRET=

# Mollie Connect test-access-token voor Phase 7 (Account-level subscriptions)
# integration-tests. NIET dezelfde sleutel als CASHIER_MOLLIE_KEY:
#  - CASHIER_MOLLIE_KEY is Emeq's eigen Mollie API-key (test_-prefix) voor use-case A.
#  - MOLLIE_CONNECT_TEST_ACCESS_TOKEN representeert een merchant-account dat via
#    Connect bereikt wordt (use-case B; access_-prefix). Verkrijg via Mollie
#    Dashboard → Settings → Developers → Personal access tokens (test-mode).
# Format: `access_xxxxxxxxxxxxxxxxxxxxxx`. Tests skippen automatisch op empty
# of placeholder. Run `composer test:integration` om actief te gebruiken.
# Zie tests/Integration/AccountSubscriptions/AccountSubscriptionIntegrationTestCase.php
# voor de skip-logica.
MOLLIE_CONNECT_TEST_ACCESS_TOKEN=access_xxx

# Billing admin-allowlist — tot Phase 9 Filament-panel landt is een
# Consumer-ID-lijst de gatekeeper voor /v1/admin/billing/*-endpoints.
# Comma-separated integers, geen spaces. Laat leeg om alle admin-routes
# default-deny te zetten (default).
BILLING_ADMIN_CONSUMER_IDS=
BILLING_DEFAULT_SUBSCRIPTION_NAME=main

# Integration tests (Phase 6 D-12)
# `composer test:integration` of `vendor/bin/phpunit --configuration=phpunit.integration.xml`
# vereist een geldige Mollie test-mode key in .env (NIET .env.example).
# Tests skippen automatisch bij empty of non-test-prefixed CASHIER_MOLLIE_KEY.
# CI runt deze suite apart in een dedicated workflow-step die de key uit
# GitHub secrets injecteert. Standaard `php artisan test` skipt deze tests
# via `<groups><exclude><group>integration</group></exclude></groups>` in phpunit.xml.
# Zie tests/Integration/IntegrationTestCase.php voor de skip-logica.

# Moneybird
MONEYBIRD_PARTNER_CLIENT_ID=
MONEYBIRD_PARTNER_CLIENT_SECRET=

NIGHTWATCH_TOKEN=
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.1

# Sentry — exception capture only. Nightwatch blijft de APM.
# DSN per environment in lokale .env / VPS `.env.prod`; nooit hier committen.
# SENTRY_TRACES_SAMPLE_RATE=0.0: geen performance-traces vanuit Sentry — Nightwatch doet dat.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# CORS — consumer-SPA's roepen de /v1-API direct vanuit de browser aan.
# Elke https-origin mag (multi-tenant: emeq.nl, planny.nl, …, geen per-consumer
# config); auth is altijd de PAT. CORS_ALLOWED_ORIGINS = expliciete dev-hosts
# over http (csv), default localhost:3000.
CORS_ALLOWED_ORIGINS=http://localhost:3000
