APP_NAME="Emeq Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://hub.emeq.test:8090

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,laravel-cloud-socket,nightwatch
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=emeq_hub
DB_USERNAME=emeq_hub
DB_PASSWORD=emeq_hub

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hub@emeq.nl"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=hub.emeq.test

HORIZON_PREFIX=emeq-hub

# Scramble — Scramble's /docs/api is local-open. Op productie blokkeert
# RestrictedDocsAccess de UI tenzij ?token=<value> matched met onderstaande env.
# Laat leeg om de docs UI op niet-local environments volledig te blokkeren.
# Vervang door staff-auth zodra Phase 9 (Filament admin-UI) live is.
SCRAMBLE_ACCESS_TOKEN=
API_VERSION=0.2.0-dev

# Snelstart
SNELSTART_PARTNER_APP_NAME=
SNELSTART_PRIMARY_KEY=
SNELSTART_SECONDARY_KEY=

# Mollie
MOLLIE_PARTNER_CLIENT_ID=
MOLLIE_PARTNER_CLIENT_SECRET=

# Mollie Connect (OAuth-broker — Phase 4)
MOLLIE_CONNECT_CLIENT_ID=
MOLLIE_CONNECT_CLIENT_SECRET=
MOLLIE_CONNECT_REDIRECT_URI=https://hub.emeq.test:8090/v1/oauth/mollie/callback

# Mollie webhook signing — platform-secret van Mollie Connect (Phase 5a D-08)
MOLLIE_WEBHOOK_SECRET=

# Cashier-Mollie — Emeq's eigen Mollie test-account (use-case A, Phase 6)
# Dit is NIET een Connect-token (= Phase 4/5a/7) en NIET een Consumer-credential.
# Dit is de test-API-key uit Emeq's eigen Mollie-dashboard waar Naschool/Planny
# op factureren. Productiekey komt pas bij milestone-go-live, niet in v0.2.
# CASHIER_MOLLIE_KEY en MOLLIE_KEY moeten identiek zijn — laravel-mollie ^4.0
# leest `MOLLIE_KEY`, Cashier-Mollie's docs verwijzen naar `CASHIER_MOLLIE_KEY`.
CASHIER_MOLLIE_KEY=test_xxx
MOLLIE_KEY=test_xxx

# Webhook-secret voor Cashier-webhook hard-fail-guard (Phase 5a-pattern, plan 06-06).
# Genereer met `openssl rand -hex 32` en plak hier + in Mollie-dashboard's
# webhook-endpoint config. Leeg/null laat het Cashier-webhook hard-failen
# (500 + audit-row) — bewust, om open ingress te voorkomen.
CASHIER_WEBHOOK_SECRET=

# Moneybird
MONEYBIRD_PARTNER_CLIENT_ID=
MONEYBIRD_PARTNER_CLIENT_SECRET=

NIGHTWATCH_TOKEN=
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.1